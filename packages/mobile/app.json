        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#0B2A4A"
      },
      "edgeToEdgeEnabled": true
    },
    "extra": {
      "apiUrl": "https://gestion-3j817l5-preview-4200.runable.site/",
